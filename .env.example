# Copy to .env and edit. Every value here is the default.

# Host interface and port the app is published on. Keep 127.0.0.1 when the
# reverse proxy runs on the same host; the app itself has no authentication.
MARKPORT_BIND=127.0.0.1
MARKPORT_PORT=3000

# Where vaults are stored. A name means a Docker named volume; a path
# (./data, /srv/markport) means a host directory, which must be writable by
# uid 1000:  sudo chown -R 1000:1000 /srv/markport
MARKPORT_DATA=markport-data

# Vault created on first start when the data directory has none.
DEFAULT_VAULT_NAME=Notes

# true if the data directory is on NFS/SMB/rclone, where file-change events
# don't arrive (edits made outside the app would otherwise not show up).
WATCH_POLLING=false

# Obsidian release to bundle. 1.13+ does not boot - change only after reading
# docs/obsidian-version-support.md.
OBSIDIAN_VERSION=1.12.7
